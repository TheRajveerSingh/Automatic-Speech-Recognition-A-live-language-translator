# Copy this file to ".env" and change what you need. ".env" is git-ignored.
# Every value is optional - the defaults below are used when a line is missing.

# Whisper speech recognition
WHISPER_MODEL=large-v3-turbo      # tiny | small | medium | large-v3 | large-v3-turbo
WHISPER_DEVICE=auto               # auto | cuda | cpu

# Local LLM (Ollama) used for translation and summaries
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Web server
HOST=127.0.0.1
PORT=8000

# Generated audio in outputs/ older than this is deleted automatically
OUTPUT_MAX_AGE_HOURS=24

# No API keys are needed - everything runs locally. If you ever add a cloud
# service, put its key here (e.g. SOME_SERVICE_API_KEY=...), never in the code.
